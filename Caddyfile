{$DOMAIN::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}

	@private_oauth path /auth/google/* /account/security /account/google/* /mcp /mcp/oauth/* /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/mcp
	header @private_oauth {
		Cache-Control "no-store"
		Referrer-Policy "no-referrer"
		defer
	}

	# Public storefronts read the active snapshot from disk.
	handle_path /s/* {
		root * /srv/storefronts

		@storefront_staging path /.tmp /.tmp/*
		handle @storefront_staging {
			respond 404
		}

		@storefront_file file {
			try_files {path} {path}/index.html
		}
		handle @storefront_file {
			@storefront_worker path */sw.js
			header @storefront_worker Cache-Control "no-cache"

			@storefront_resources path */manifest.webmanifest */icon-*.png
			header @storefront_resources Cache-Control "public, max-age=300"

			@storefront_immutable path */catalog.v*.json */media/* */theme-*.css
			header @storefront_immutable Cache-Control "public, max-age=31536000, immutable"

			@storefront_html path */ */index.html
			header @storefront_html Cache-Control "public, max-age=60, stale-while-revalidate=300"

			rewrite * {http.matchers.file.relative}
			file_server {
				hide /srv/storefronts/.tmp
			}
		}
		handle {
			rewrite * /s{path}
			reverse_proxy app:8080
		}
	}

	# Published static public menus served directly off disk without hitting Rust or SQLite.
	handle_path /c/* {
		root * /srv/published

		@staging path /.tmp /.tmp/*
		handle @staging {
			respond 404
		}

		@published file {
			try_files {path} {path}/index.html
		}
		handle @published {
			@immutable path */media/* */theme-*.css
			header @immutable Cache-Control "public, max-age=31536000, immutable"

			@html not path */media/* */theme-*.css
			header @html Cache-Control "public, max-age=60, stale-while-revalidate=300"

			rewrite * {http.matchers.file.relative}
			file_server {
				hide /srv/published/.tmp
			}
		}
		handle {
			rewrite * /c{path}
			reverse_proxy app:8080
		}
	}

	handle_errors 5xx {
		root * /srv/static
		header Cache-Control "no-store"
		rewrite * /errors/unavailable.html
		file_server
	}

	# Embedded i18n JSON endpoints served by the Rust app (with ETag + immutable caching).
	handle /static/i18n/* {
		reverse_proxy app:8080
	}

	# Static CSS, JS, and icons served directly by Caddy.
	handle_path /static/* {
		root * /srv/static
		@versioned query v=*
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		@unversioned not query v=*
		header @unversioned Cache-Control "public, max-age=60, must-revalidate"
		file_server
	}

	# Dynamic owner dashboard, auth, QR generation, and landing page.
	handle {
		reverse_proxy app:8080
	}
}
