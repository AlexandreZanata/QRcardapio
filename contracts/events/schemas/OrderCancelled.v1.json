{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qrcardapio:event:OrderCancelled:1",
  "title": "OrderCancelled v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "reason_code",
    "cancelled_by"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason_code": {
      "enum": [
        "consumer_request",
        "item_unavailable",
        "delivery_failed",
        "payment_issue",
        "other"
      ]
    },
    "cancelled_by": {
      "enum": [
        "consumer",
        "owner",
        "manager"
      ]
    }
  }
}
