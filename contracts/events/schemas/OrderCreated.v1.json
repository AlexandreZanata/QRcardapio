{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qrcardapio:event:OrderCreated:1",
  "title": "OrderCreated v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "channel",
    "total_centavos",
    "item_count",
    "catalog_version"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "channel": {
      "enum": [
        "delivery",
        "pickup",
        "table",
        "counter",
        "manual",
        "external"
      ]
    },
    "total_centavos": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "item_count": {
      "type": "integer",
      "minimum": 1
    },
    "catalog_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
