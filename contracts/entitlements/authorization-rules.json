    {
      "role": "system",
      "scope": "platform",
      "status": "planned",
      "notes": "Idempotent outbox consumers acting for one establishment. They run only when the triggering event was produced under a valid operation and re-check the consumer module's own capability."
    }
  ],
  "after_expiry_values": {
    "deny": "Creates new protected commercial activity; requires an active capability.",
    "allow": "Free QR Core operation or completion/reversal of existing work; never requires a capability.",
    "complete_existing": "Allowed only for operations already started while the capability was active; never creates new work."
  },
