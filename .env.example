# QR Cardapio configuration
BIND_ADDR=127.0.0.1:8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
DATA_DIR=./data
STATIC_DIR=./static

# SQLite settings
DB_MAX_CONNECTIONS=5
# FULL (highest durability) or NORMAL
DB_SYNCHRONOUS=FULL

# HTTP / Cookie security
# Set to true behind HTTPS in production
COOKIE_SECURE=false
# Set to true behind a trusted reverse proxy (e.g., Caddy) for X-Forwarded-For rate limiting
TRUST_PROXY=false

# Logging: pretty (dev) or json (prod)
LOG_FORMAT=pretty
LOG_LEVEL=info,qrcardapio=debug

# Leave all three empty to disable billing. Use sandbox or production.
# Billing requires an HTTPS PUBLIC_BASE_URL and COOKIE_SECURE=true.
ASAAS_ENV=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Stripe (card subscriptions on hosted Checkout). The key prefix selects the environment
# (sk_test_/rk_test_ = sandbox, sk_live_/rk_live_ = production). Create the webhook endpoint
# at <PUBLIC_BASE_URL>/webhooks/stripe with API version 2026-11-18.endive (snapshot payloads).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Banco Inter (Pix/boleto charge per cycle). mTLS certificate and key from the Inter integration.
# Register the callback with `qrcardapio billing register-inter-webhook`.
INTER_ENV=
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=
INTER_KEY_PATH=
# Only when the integration covers more than one current account (digits only).
INTER_ACCOUNT=
# 32+ letters/digits; becomes part of the callback path /webhooks/inter/<token>.
INTER_WEBHOOK_TOKEN=

# Required when both Asaas and Stripe are configured: which one processes cards (asaas|stripe).
# All configured providers must use the same environment.
BILLING_CARD_PROVIDER=

# MCP for connected AI clients. Requires a public HTTPS origin and secure cookies.
MCP_ENABLED=false

# Google OAuth web application. Set both credentials to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional browser Web Push. The P-256 private key file must be PKCS#8 DER.
COMMERCE_VAPID_PRIVATE_KEY_FILE=
COMMERCE_VAPID_CONTACT=
