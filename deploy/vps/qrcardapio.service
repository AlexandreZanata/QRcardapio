[Unit]
Description=QR Cardapio SaaS web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qrcardapio
Group=qrcardapio
WorkingDirectory=/var/lib/qrcardapio
EnvironmentFile=/etc/qrcardapio/server.env
ExecStart=/opt/qrcardapio/current/bin/qrcardapio serve
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=30
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/qrcardapio

[Install]
WantedBy=multi-user.target
