[Unit]
Description=QR Cardapio CI-attested pull auto-deploy agent
After=network-online.target qrcardapio.service
Wants=network-online.target
ConditionPathExists=/etc/qrcardapio/auto-deploy.enabled

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/lib/qrcardapio-deploy
EnvironmentFile=-/etc/qrcardapio/deploy.env
Environment=GH_CONFIG_DIR=/var/lib/qrcardapio-deploy/gh
Environment=XDG_CACHE_HOME=/var/lib/qrcardapio-deploy/cache
Environment=XDG_DATA_HOME=/var/lib/qrcardapio-deploy/data
ExecStart=/usr/bin/python3 /opt/qrcardapio/agent/qrcardapio-deploy-agent.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=240
Nice=15
IOSchedulingClass=idle
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/qrcardapio /var/lib/qrcardapio /var/lib/qrcardapio-deploy /var/backups/qrcardapio
